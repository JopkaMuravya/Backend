<!DOCTYPE html>
<html>
<head>
    <title>Главная</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-light bg-light">
        <div class="container">
            <a class="navbar-brand" href="{{ path('app_home') }}">Мой сайт</a>
            <div class="navbar-nav ms-auto">
                {% if app.user %}
                    <span class="nav-item nav-link">Привет, {{ app.user.firstName }}!</span>
                    <a class="nav-item nav-link" href="{{ path('app_logout') }}">Выйти</a>
                {% else %}
                    <a class="nav-item nav-link" href="{{ path('app_login') }}">Войти</a>
                {% endif %}
            </div>
        </div>
    </nav>
    
    <div class="container mt-4">
        <h1>Добро пожаловать!</h1>
        
        {% if app.user %}
            <div class="alert alert-success">
                <h4>Вы авторизованы</h4>
                <p>Телефон: {{ app.user.phone }}</p>
                <p>Email: {{ app.user.email }}</p>
                <p>Яндекс ID: {{ app.user.yandexId }}</p>
            </div>
        {% else %}
            <div class="alert alert-info">
                <p>Пожалуйста, <a href="{{ path('app_login') }}">войдите</a> для доступа</p>
            </div>
        {% endif %}
    </div>
</body>
</html>